# URL publik situs tanpa slash di akhir
NEXT_PUBLIC_SITE_URL=https://domain-kamu.com

# Supabase browser-safe values (boleh tersedia di client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Jangan pernah gunakan NEXT_PUBLIC_ pada service role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
